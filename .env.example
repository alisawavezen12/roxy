# Application environment
APP_ENV=development

# HTTP runtime configuration
# The container listens on all interfaces; change PORT only when the host requires it.
PORT=8080

# PostgreSQL runtime configuration
# PostgreSQL service hostname inside Docker Compose.
DATABASE_URL=postgres://roxy:change-me@postgres:5432/roxy
POSTGRES_USER=roxy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=roxy
DATABASE_POOL_SIZE=10
DATABASE_QUERY_TIMEOUT_MS=5000

# Wisp signing and encryption secret. Use a unique value with at least 64 characters.
SECRET_KEY_BASE=dev-only-secret-key-base-change-me-please-not-for-prod-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Comma-separated frontend origins allowed to call the API with credentials.
# Each value must include scheme, host, and optional port. Required in production.
CORS_ALLOWED_ORIGINS=http://localhost:1234

# External S3-compatible storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=roxy
S3_ACCESS_KEY=roxy
S3_SECRET_KEY=roxy-dev-minio
