# Required in every environment
# Register the application in Dobrunia Auth and replace the example UUID.
DOBRUNIA_AUTH_CLIENT_ID=00000000-0000-4000-8000-000000000000
# Separate secret used to encrypt provider access/refresh tokens in PostgreSQL.
# Generate a unique random value with at least 32 characters.
AUTH_TOKEN_ENCRYPTION_KEY=change-me-generate-a-random-secret-at-least-32-characters

# Application environment
APP_ENV=development

# The values below have built-in development defaults.
# Configure them explicitly for production.

# HTTP runtime configuration
# The container listens on all interfaces; change PORT only when the host requires it.
PORT=8080

# PostgreSQL runtime configuration
# PostgreSQL service hostname inside Docker Compose.
DATABASE_URL=postgres://roxy:change-me@postgres:5432/roxy
POSTGRES_USER=roxy
POSTGRES_PASSWORD=change-me
POSTGRES_DB=roxy
DATABASE_POOL_SIZE=10
DATABASE_QUERY_TIMEOUT_MS=5000

# Wisp signing and encryption secret. Use a unique value with at least 64 characters.
SECRET_KEY_BASE=dev-only-secret-key-base-change-me-please-not-for-prod-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Comma-separated frontend origins allowed to call the API with credentials.
# Each value must include scheme, host, and optional port. Required in production.
CORS_ALLOWED_ORIGINS=http://localhost:1234,http://127.0.0.1:1234

# Public transport policy.
# Development may use http://localhost. Production must use https://.
PUBLIC_BASE_URL=http://localhost:8080

# Comma-separated IPs of trusted TLS-terminating proxies.
# Leave empty in development. Required in production when using X-Forwarded-Proto.
# Example: 10.0.0.2,10.0.0.3
TRUSTED_PROXY_IPS=

# Comma-separated IPs allowed to access the backend directly over the trusted
# internal network without X-Forwarded-Proto. Leave empty in development.
# Example: 172.18.0.2,172.18.0.3
TRUSTED_INTERNAL_IPS=

# Production only; development uses http://localhost:1234.
# FRONTEND_URL=https://app.example.com

# External S3-compatible storage
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=roxy
S3_ACCESS_KEY=roxy
S3_SECRET_KEY=roxy-dev-minio
